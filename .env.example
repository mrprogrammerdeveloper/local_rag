# Ollama LLM Configuration (Set to any model tag pulled via `ollama pull <tag>`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Data Paths
PDF_PATH=data/pdfs
VECTOR_PATH=data/vector_store
REFERENCES_PATH=data/references

# Embedding Model (BAAI/bge-m3 dense 1024-d representations)
EMBEDDING_MODEL=BAAI/bge-m3

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# Retrieval Configuration
TOP_K=5
RETRIEVAL_CANDIDATES=8

# Reranker Configuration
# Use 'cpu' for low-VRAM GPUs (e.g., 4GB) to conserve memory for Ollama, or 'cuda' for high-VRAM discrete GPUs
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=4